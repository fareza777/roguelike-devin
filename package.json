{
  "name": "dreadmarch",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "android:sync": "npm run build && cap sync android && node scripts/patch-android.mjs",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/admob": "7.2.0",
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6",
    "capacitor-plugin-cdv-purchase": "^13.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
